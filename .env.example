# ==========================================
# DATABASE (Railway Managed PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/gbys

# ==========================================
# BETTER AUTH
# ==========================================
BETTER_AUTH_SECRET=replace-with-32-char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Authorized redirect: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (all four required to enable; see README "Sign in with Apple setup")
# APPLE_CLIENT_ID is the Services ID (not the App ID). Return URL: {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key on ONE line, newlines written as a literal \n, e.g.:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=
# Optional: native iOS app bundle ID (accepted as an additional id_token audience)
APPLE_APP_BUNDLE_ID=

# ==========================================
# NUNTLY EMAIL (@nuntly/sdk)
# ==========================================
NUNTLY_API_KEY=
NUNTLY_FROM_EMAIL=noreply@goldbeachyouthsports.org
NUNTLY_WEBHOOK_SECRET=

# ==========================================
# STRIPE & STRIPE CONNECT
# ==========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==========================================
# RAILWAY OBJECT STORAGE (S3-Compatible)
# ==========================================
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=gbys-private-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ==========================================
# INTERNAL CRON & APP CONFIG
# ==========================================
CRON_SECRET=replace-with-random-cron-secret
DEFAULT_IN_KIND_HOURLY_RATE_CENTS=3349
APP_TIMEZONE=America/Los_Angeles
